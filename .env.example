# ==============================================================
# Hela Hop Fintech — Environment Variables
# Copy this file to .env.local and fill in your real credentials.
# NEVER commit .env.local to version control.
# ==============================================================

# ── Application Configuration ──────────────────────────────────
# Public URL of the web application (used for callbacks, redirects, links)
# Also used by the CSRF check on /api/mpesa/stk-push: it must match the URL in
# the browser's address bar exactly (scheme + host + port).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Comma-separated emails allowed to open /admin/* (Task 1.9, until Task 2.5).
# Server-side only. Empty means nobody can open /admin.
ADMIN_EMAILS=

# ── Supabase Configuration ─────────────────────────────────────
# Supabase project URL (Client-side and Server-side)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Server-side alias for SUPABASE_URL (optional if NEXT_PUBLIC_SUPABASE_URL is provided)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase public anonymous API key (safe for browser exposure)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Server-side alias for SUPABASE_ANON_KEY (optional if NEXT_PUBLIC_SUPABASE_ANON_KEY is provided)
SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role secret key (Server-side ONLY, full database access, bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── Email (seller "new claim" notifications, Task 1.5) ─────────
# Resend API key (Server-side ONLY). Get one at https://resend.com
# If empty, claims still work; the seller just does not get an email.
RESEND_API_KEY=
# Sender shown on emails. Use a domain verified in Resend for production.
# The default below only works for testing with your own Resend account email.
EMAIL_FROM=Hela Hop <onboarding@resend.dev>

# ── Safaricom Daraja API (M-PESA) ──────────────────────────────
# Environment: "sandbox" or "production"
DARAJA_ENV=sandbox
# Consumer Key from Daraja Developer Portal
DARAJA_CONSUMER_KEY=your-daraja-consumer-key
# Consumer Secret from Daraja Developer Portal
DARAJA_CONSUMER_SECRET=your-daraja-consumer-secret
# Business Shortcode / Paybill / Till Number (e.g. 174379 for sandbox)
DARAJA_SHORTCODE=174379
# Passkey for Lipa Na M-PESA Online (STK Push)
DARAJA_PASSKEY=your-daraja-passkey

# ── IntaSend Payments & Payouts ────────────────────────────────
# Environment: "sandbox" or "production"
INTASEND_ENV=sandbox
# IntaSend Publishable Key (for client-side checkout if needed)
INTASEND_PUBLISHABLE_KEY=your-intasend-publishable-key
# IntaSend Secret Key (Server-side only for API collections & payouts)
INTASEND_SECRET_KEY=your-intasend-secret-key
