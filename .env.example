# ==============================================================
# Hela Hop — Environment Variables
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to git.
# ==============================================================

# ── App ────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase ───────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── Safaricom Daraja (M-PESA) ──────────────────────────────────
# Environment: "sandbox" | "production"
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=your-daraja-consumer-key
DARAJA_CONSUMER_SECRET=your-daraja-consumer-secret
DARAJA_SHORTCODE=174379
DARAJA_PASSKEY=your-daraja-passkey

# ── IntaSend ───────────────────────────────────────────────────
# Environment: "sandbox" | "production"
INTASEND_ENV=sandbox
INTASEND_PUBLISHABLE_KEY=your-intasend-publishable-key
INTASEND_SECRET_KEY=your-intasend-secret-key

